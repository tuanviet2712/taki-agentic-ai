# ===== DOTAKA Agentic AI =====
# Để trống = chạy chế độ SANDBOX (không gọi AI thật, nền tảng giả lập). Điền key để chạy thật.

# LLM Gateway — Claude CLI (mặc định), ChatGPT/Codex CLI hoặc sandbox. Chọn kết nối trong Cài đặt / Trung tâm tích hợp → AI.
# ChatGPT cần thêm hồ sơ và tự đăng nhập; không tự lấy tài khoản Codex của máy. Không dùng API key nhà cung cấp.
LLM_PROVIDER=claude_cli
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_CONCURRENCY=2

# Codex CLI: npm install -g @openai/codex. Để trống = tự tìm trên PATH (hỗ trợ shim npm trên Windows).
# Dùng Codex CLI >= 0.148.0. Phiên riêng từng hồ sơ ở data/ai-accounts/ (không commit).
CODEX_CLI_PATH=
# Ảnh đi kèm bài viết (kết nối Claude): Chrome/Edge dùng để dựng ảnh thiết kế. Để trống = tự tìm Chrome, Edge, Chromium đã cài.
POST_IMAGE_CHROME=

# Jev / TypeSafe System One — phán đoán nhanh: phân loại, chấm điểm, guardrail
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Bảng tầng mô hình (đổi không cần sửa agent)
# Model mặc định theo tầng (đổi trong Cài đặt → Model Claude, hoặc riêng từng agent)
LLM_MODEL_LARGE=claude-opus-5-5
LLM_MODEL_MEDIUM=claude-sonnet-5-5
LLM_MODEL_SMALL=claude-haiku-5-5

API_PORT=8787
DB_PATH=data/dotaka.db
# Khóa mã hóa token nền tảng (32 byte hex). Production: lấy từ KMS/vault.
TOKEN_ENCRYPTION_KEY=
# Bí mật ký webhook (mỗi nền tảng một bí mật trong production)
WEBHOOK_SECRET=dev-webhook-secret
# Telegram cảnh báo (tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lần chạy đầu: blank = DNA + skill + cấu hình TAKI, không có dữ liệu mẫu (demo = kèm dữ liệu mẫu)
SEED_MODE=blank

# ===== Đăng Instagram / TikTok, đăng nhập bằng nút, link đo click =====
# Cổng CÔNG KHAI (mặc định tắt = không có cổng nào): chỉ phục vụ /r/<mã> (đo click), /m/<token> (media đã duyệt cho Instagram),
# callback OAuth và /healthz. Chạy tunnel (vd: cloudflared tunnel --url http://localhost:8788) CHỈ trỏ về cổng này — KHÔNG trỏ về
# cổng chính API_PORT (API chính không có đăng nhập).
PUBLIC_PORT=
# Địa chỉ https mà tunnel / tên miền trỏ tới cổng công khai. Link /r/<mã> chỉ dùng khi là địa chỉ ỔN ĐỊNH (không phải *.trycloudflare.com).
PUBLIC_BASE_URL=
# Facebook Login (Fanpage + Instagram Business): Redirect URI mặc định http://localhost:API_PORT/v1/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# TikTok Login Kit (Redirect URI bắt buộc https = PUBLIC_BASE_URL/v1/oauth/tiktok/callback)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Chỉ đặt khi Redirect URI khác mặc định (vd. đang truy cập qua tên miền riêng)
OAUTH_REDIRECT_BASE=
# Tên miền được phép truy cập API chính ngoài localhost / IP / tên máy (cách nhau dấu phẩy) — lớp chặn DNS rebinding
ALLOWED_HOSTS=

# Claude in Chrome (chọn trên giao diện; mặc định vẫn Chrome Flow).
# 0 = tắt bộ duyệt tự động; để trống = cho phép sau khi Sếp bật trên giao diện.
# Tạo data/chrome-autoapprove.off để chặn cả lượt đang chạy, không cần khởi động lại.
ALLOW_CHROME_AUTOAPPROVE=
